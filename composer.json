{
    "name": "horde/barcode",
    "description": "Horde Barcode and QR Code Rendering and Parsing Library",
    "type": "library",
    "homepage": "http://www.horde.org/libraries/Horde_Barcode",
    "license": "LGPL-2.1",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "maintainer"
        }
    ],
    "keywords": [
        "barcode",
        "qrcode",
        "qr",
        "code128",
        "ean",
        "datamatrix",
        "gs1"
    ],
    "time": "2026-05-12",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "horde/image": "^3 || dev-FRAMEWORK_6_0",
        "horde/pdf": "^3 || dev-FRAMEWORK_6_0",
        "horde/otp": "^1 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/image": "^3 || dev-FRAMEWORK_6_0",
        "horde/pdf": "^3 || dev-FRAMEWORK_6_0",
        "horde/otp": "^1 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-4": {
            "Horde\\Barcode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Barcode\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "1.x-dev"
        }
    }
}